# ---------------------------------------------------------------------------
# historia-paralela — variables de entorno
# Copiar a .env y rellenar. NUNCA commitear el .env real.
# ---------------------------------------------------------------------------

PORT=3000
NODE_ENV=development

# --- IA (nunca se expone al frontend: todas las llamadas salen del backend) ---
# DeepSeek, compatible con el formato de OpenAI (/chat/completions).
# Solo hace falta un modelo de TEXTO: las escenas no son imagenes generadas,
# son datos que se dibujan por codigo (ver packages/escena).
IA_API_URL=https://api.deepseek.com
IA_API_KEY=
# deepseek-v4-flash (rapido y barato) o deepseek-v4-pro (mejor prosa)
IA_MODELO_TEXTO=deepseek-v4-flash
IA_MAX_TOKENS=1400
# Razonamiento del modelo. "disabled" por defecto: en deepseek-v4-* el
# razonamiento consume el mismo max_tokens que la respuesta y deja el JSON
# vacio. Ver la medicion comentada en services/iaClient.ts.
IA_RAZONAMIENTO=disabled
# Si no hay IA_API_KEY, el backend usa un director simulado (modo demo offline).

# --- Portal (realtime) ---
# La publishable key viaja al navegador; la secret key JAMAS.
PORTAL_PUBLISHABLE_KEY=
PORTAL_SECRET_KEY=

# --- JWT para autenticar contra Portal ---
# Portal verifica por JWKS (RS256). Si no se define clave privada, el backend
# genera un par efimero al arrancar (valido para desarrollo).
JWT_ISSUER=http://localhost:3000
JWT_PRIVATE_KEY_PEM=
# Secreto HMAC propio: firma el handshake backend <-> portal.config.ts (authz de cupo).
JWT_SIGNING_SECRET=cambiar-esto-en-produccion

# --- Video / FFmpeg ---
FFMPEG_PATH=
VIDEO_EXPIRY_SECONDS=300

# --- Seguridad ---
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=60

# --- Reglas del juego ---
# Duracion total de una historia. El spec menciona 2 y 3 minutos en distintos
# puntos; se parametriza y el default es 180s (ver DECISIONS.md).
HISTORIA_DURACION_SEGUNDOS=180
TURNO_DURACION_MS=20000
TURNO_GRACIA_MS=3000

# --- Redis (OPCIONAL, solo cache efimero; jamas persistencia de historias) ---
REDIS_URL=
